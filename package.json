{
  "name": "neo-astra",
  "version": "1.0.0",
  "private": true,
  "description": "Neo Astra compiler workspace.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "orchestrator/packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "package": "node scripts/package.mjs",
    "package:npm": "node scripts/package-npm.mjs",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "astra": "node orchestrator/packages/cli/dist/index.js",
    "nova": "cargo run -q -p astra-nova --bin nova --",
    "nopm": "node orchestrator/packages/nopm/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "bun": "^1.4.4",
    "typescript": "7.0.2"
  }
}
